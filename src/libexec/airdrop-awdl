#!/bin/sh
# Avvia/ferma il collegamento AWDL (OWL) per AirDrop. Eseguito tramite pkexec
# (azione polkit dedicata, consentita all'utente della sessione attiva).
#   airdrop-awdl avvia INTERFACCIA CANALE
#   airdrop-awdl ferma
set -eu
case "${1:-}" in
	avvia)
		INTERFACCIA=${2:?interfaccia}
		CANALE=${3:-6}
		case "$INTERFACCIA" in *[!a-z0-9]*) echo "interfaccia non valida" >&2; exit 1 ;; esac
		case "$CANALE" in 6|44|149) ;; *) echo "canale non valido" >&2; exit 1 ;; esac
		[ -d "/sys/class/net/$INTERFACCIA/wireless" ] || { echo "non è un'interfaccia Wi-Fi" >&2; exit 1; }
		mkdir -p /run/nucleo
		printf 'OWL_INTERFACCIA=%s\nOWL_CANALE=%s\n' "$INTERFACCIA" "$CANALE" >/run/nucleo/owl.env
		nmcli device set "$INTERFACCIA" managed no 2>/dev/null || true
		systemctl restart nucleo-owl.service
		;;
	ferma)
		systemctl stop nucleo-owl.service || true
		if [ -f /run/nucleo/owl.env ]; then
			. /run/nucleo/owl.env
			ip link set "$OWL_INTERFACCIA" down 2>/dev/null || true
			iw dev "$OWL_INTERFACCIA" set type managed 2>/dev/null || true
			nmcli device set "$OWL_INTERFACCIA" managed yes 2>/dev/null || true
		fi
		;;
	*) echo "uso: airdrop-awdl avvia INTERFACCIA CANALE | ferma" >&2; exit 1 ;;
esac
