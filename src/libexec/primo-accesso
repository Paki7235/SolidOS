#!/bin/sh
# Mostra il Benvenuto al primo accesso di ogni utente (e sempre nella sessione live).
ID=$(. /etc/os-release && echo "$ID")
FATTO="${XDG_CONFIG_HOME:-$HOME/.config}/$ID/benvenuto-fatto"
grep -qw "$ID.modalita=salvataggio" /proc/cmdline && exit 0
if [ -d /run/live/medium ]; then
	[ -f "$FATTO" ] || exec "$ID-benvenuto" --live
	exit 0
fi
[ -f "$FATTO" ] && exit 0
sleep 2
exec "$ID-benvenuto"
