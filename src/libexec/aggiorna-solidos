#!/usr/bin/python3
"""Installa l'ultima versione di SolidOS pubblicata (eseguito come root).

1. legge la scheda versione.json della build più recente e ne verifica la FIRMA (chiave di
   SolidOS): una scheda non firmata o modificata non si usa;
2. se è più nuova di quella installata: scarica il pacchetto e ne verifica la somma SHA-256;
3. crea un punto di ripristino (se c'è la Linea del Tempo);
4. copia i file nuovi sopra quelli vecchi (solo dentro le cartelle di SolidOS: niente
   configurazioni dell'installazione, come l'accesso o l'installatore);
5. aggiorna il numero di versione. Le modifiche valgono dal prossimo accesso.

Uso: aggiorna-solidos [--forza]
Esce con 0 anche quando non c'è niente da fare; scrive una riga di esito su stdout.
"""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from pathlib import Path

sys.path.insert(0, "/usr/lib/python3/dist-packages")
from nucleo import aggiornamento  # noqa: E402

# Solo queste parti del sistema possono essere sostituite dal pacchetto
CONSENTITI = ("usr/", "etc/xdg/", "etc/systemd/", "etc/polkit-1/", "etc/fonts/", "etc/gtk-3.0/",
              "etc/swaylock/", "etc/sysctl.d/", "etc/udisks2/", "etc/default/earlyoom", "etc/apt/apt.conf.d/",
              "etc/firefox-esr/", "etc/snapper/")
# …tranne queste, che l'installazione personalizza o che servono solo sulla chiavetta
ESCLUSI = ("etc/greetd/", "etc/calamares/", "etc/live/", "usr/lib/live/", "etc/snapper/configs/")


def esito(messaggio: str, codice: int = 0):
    if codice:
        avanzamento("errore", 0, messaggio)
    print(messaggio)
    sys.exit(codice)


# Avanzamento per «Aggiornamento software» (leggibile da tutti)
AVANZAMENTO = Path("/run/nucleo-aggiornamento.json")


def avanzamento(fase: str, percento: float = 0, testo: str = "") -> None:
    """fase: controllo | scarica | verifica | ripristino | installa | fatto | errore"""
    try:
        tmp = AVANZAMENTO.with_suffix(".tmp")
        tmp.write_text(json.dumps({"fase": fase, "percento": round(max(0, min(100, percento)), 1),
                                   "testo": testo}, ensure_ascii=False))
        tmp.chmod(0o644)
        tmp.replace(AVANZAMENTO)
    except OSError:
        pass


def ammesso(nome: str) -> bool:
    nome = nome.lstrip("./")
    if ".." in Path(nome).parts or nome.startswith("/"):
        return False
    return nome.startswith(CONSENTITI) and not nome.startswith(ESCLUSI)


def _pacchetti_richiesti():
    """Installa i programmi che servono alle app nuove (elenco nel pacchetto), se mancano."""
    elenco = Path("/usr/share/nucleo/pacchetti-richiesti.txt")
    if not elenco.is_file():
        return
    voluti = [r.strip() for r in elenco.read_text().splitlines() if r.strip() and not r.startswith("#")]
    mancanti = [p for p in voluti if subprocess.run(["dpkg-query", "-W", "-f=${Status}", p], capture_output=True,
                                                    text=True).stdout.strip() != "install ok installed"]
    if not mancanti:
        return
    avanzamento("installa", 99, "programmi aggiuntivi")
    ambiente = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    subprocess.run(["apt-get", "update", "-qq"], capture_output=True, env=ambiente, timeout=900)
    for p in mancanti:   # uno alla volta: se uno non esiste per questo processore, gli altri si installano lo stesso
        subprocess.run(["apt-get", "install", "-y", "-qq", "--no-install-recommends", p],
                       capture_output=True, env=ambiente, timeout=1800)


def _pacchetti_tolti():
    """Toglie i programmi che SolidOS non usa più (elenco nel pacchetto), se ci sono."""
    import re

    elenco = Path("/usr/share/nucleo/pacchetti-tolti.txt")
    if not elenco.is_file():
        return
    nomi = [r.strip() for r in elenco.read_text().splitlines() if r.strip() and not r.startswith("#")]
    nomi = [n for n in nomi if re.fullmatch(r"[a-z0-9][a-z0-9.+-]{1,80}", n)]
    presenti = [p for p in nomi if subprocess.run(["dpkg-query", "-W", "-f=${Status}", p], capture_output=True,
                                                  text=True).stdout.strip() == "install ok installed"]
    if presenti:
        ambiente = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
        subprocess.run(["apt-get", "remove", "-y", "-qq", *presenti], capture_output=True, env=ambiente, timeout=900)


def _senza_password():
    """Account senza password (creati prima di questa versione): nel gruppo che evita le
    richieste di password vuote (regola polkit 50-senza-password)."""
    cartella = Path("/var/lib/nucleo/senza-password")
    if not cartella.is_dir():
        return
    subprocess.run(["groupadd", "-f", "-r", "senzapassword"], check=False, capture_output=True)
    for voce in cartella.iterdir():
        subprocess.run(["usermod", "-aG", "senzapassword", voce.name], check=False, capture_output=True)


def main():
    if os.geteuid() != 0:
        esito("serve l'amministratore", 1)
    forza = "--forza" in sys.argv[1:]
    avanzamento("controllo", 0)
    scheda = aggiornamento.scheda_remota(timeout=30)
    if scheda is None:
        esito(f"Nessun aggiornamento installato: {aggiornamento.ultimo_errore or 'server non raggiungibile'}", 2)
    nuova, installata = int(scheda["versione"]), aggiornamento.versione_installata()
    if nuova <= installata and not forza:
        AVANZAMENTO.unlink(missing_ok=True)
        esito(f"SolidOS è già aggiornato (versione {installata})")
    file_nome = str(scheda.get("file", ""))
    atteso = str(scheda.get("sha256", "")).lower()
    if "/" in file_nome or not file_nome.endswith(".tar.xz") or len(atteso) != 64:
        esito("Scheda dell'aggiornamento non valida", 3)

    with tempfile.TemporaryDirectory(prefix="aggiorna-solidos-") as cartella:
        pacchetto = Path(cartella) / file_nome
        richiesta = urllib.request.Request(f"{aggiornamento.url_base()}/{file_nome}",
                                           headers={"User-Agent": "SolidOS-Aggiornamenti"})
        h = hashlib.sha256()
        try:
            with urllib.request.urlopen(richiesta, timeout=120) as r, open(pacchetto, "wb") as f:
                totale = int(r.headers.get("Content-Length") or scheda.get("dimensione") or 0)
                fatti = 0
                avanzamento("scarica", 0)
                while blocco := r.read(1 << 18):
                    h.update(blocco)
                    f.write(blocco)
                    fatti += len(blocco)
                    if totale:
                        avanzamento("scarica", fatti * 100 / totale,
                                    f"{fatti / 1048576:.1f} MB di {totale / 1048576:.1f} MB".replace(".", ","))
        except OSError as e:
            esito(f"Download non riuscito: {e}", 4)
        avanzamento("verifica", 100)
        if h.hexdigest() != atteso:
            esito("Il file scaricato è danneggiato (somma di controllo diversa): riprova più tardi", 5)

        avanzamento("ripristino", 0)
        if Path("/etc/snapper/configs/root").is_file():
            subprocess.run(["snapper", "-c", "root", "create", "-c", "number",
                            "-d", f"Prima di SolidOS versione {nuova}"], check=False)

        valido = lambda m: (m.isfile() or m.isdir() or m.issym()) and ammesso(m.name)  # noqa: E731
        with tarfile.open(pacchetto) as t:
            totale = sum(1 for m in t.getmembers() if valido(m))
        # seconda lettura in sequenza (un archivio compresso non si legge bene saltando avanti e indietro)
        avanzamento("installa", 0)
        with tarfile.open(pacchetto, "r|xz") as t:
            fatti = 0
            for m in t:
                if not valido(m):
                    continue
                t.extract(m, "/", filter="tar")
                fatti += 1
                if fatti % 40 == 0:
                    avanzamento("installa", fatti * 100 / max(1, totale))

    aggiornamento.FILE_VERSIONE.write_text(f"{nuova}\n")
    # Servizi o regole cambiati: si ricaricano (le app e la shell si aggiornano al prossimo accesso)
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    subprocess.run(["systemd-tmpfiles", "--create"], check=False, capture_output=True)
    _senza_password()
    try:
        _pacchetti_richiesti()
        _pacchetti_tolti()
    except (OSError, subprocess.TimeoutExpired):
        pass
    subprocess.run(["glib-compile-schemas", "/usr/share/glib-2.0/schemas"], check=False, capture_output=True)
    subprocess.run(["update-desktop-database", "-q", "/usr/share/applications"], check=False, capture_output=True)
    avanzamento("fatto", 100, str(nuova))
    esito(f"SolidOS aggiornato alla versione {nuova}")


if __name__ == "__main__":
    main()
