#!/bin/sh
# Componenti aggiuntivi compilati o configurati nel chroot (Fasi 4-10).
# Ogni passo è facoltativo: un errore qui non deve impedire di produrre la ISO.
export DEBIAN_FRONTEND=noninteractive
registro() { echo "[@OS_ID@/componenti] $*"; }

# ── Wine a 32 bit (molti programmi di altri sistemi sono ancora a 32 bit) ──────────────
# (sui PC Intel/AMD; su ARM c'è il blocco successivo con Box64)
if [ "$(dpkg --print-architecture)" = amd64 ]; then
	if ! dpkg --print-foreign-architectures | grep -qx i386; then
		dpkg --add-architecture i386
		apt-get update -qq || true
	fi
	apt-get install -y -qq --no-install-recommends wine32:i386 >/dev/null 2>&1 \
		&& registro "wine32 installato" || registro "wine32 non disponibile (solo programmi a 64 bit)"
fi

# ── Wine su ARM: Wine per Intel/AMD (64 e 32 bit, «wow64») eseguito da Box64 ──
# Box64 traduce le istruzioni Intel per il processore ARM e si registra nel kernel
# (binfmt), così «wine» si usa come sui PC Intel/AMD: stessi passaggi, solo più lento.
if [ "$(dpkg --print-architecture)" = arm64 ] && command -v box64 >/dev/null; then
	WINE_VERSIONE=11.0
	WINE_SHA256=39574efa1132c3ca0d5c77dd2eddbe4a49cca0d6cc2c290ff4924493a1c40314
	# librerie native che Box64 usa al posto di quelle Intel (grafica, caratteri, suoni, rete sicura)
	apt-get install -y -qq --no-install-recommends libfreetype6 libfontconfig1 libx11-6 libxext6 libxrender1 \
		libxrandr2 libxi6 libxcursor1 libxinerama1 libxcomposite1 libgl1 libvulkan1 libgnutls30t64 \
		libasound2t64 libpulse0 libdbus-1-3 >/dev/null 2>&1 || registro "alcune librerie per Wine su ARM non disponibili"
	if python3 - "$WINE_VERSIONE" "$WINE_SHA256" <<'PY'
import hashlib, sys, tarfile, urllib.request, shutil, os
versione, atteso = sys.argv[1], sys.argv[2]
url = f"https://github.com/Kron4ek/Wine-Builds/releases/download/{versione}/wine-{versione}-amd64-wow64.tar.xz"
file = "/tmp/wine-x86_64.tar.xz"
with urllib.request.urlopen(url, timeout=300) as r, open(file, "wb") as f:
    shutil.copyfileobj(r, f)
if hashlib.sha256(open(file, "rb").read()).hexdigest() != atteso:
    sys.exit("somma di controllo sbagliata")
with tarfile.open(file) as t:
    radice = t.getnames()[0].split("/")[0]
    t.extractall("/opt", filter="tar")
os.replace(f"/opt/{radice}", "/opt/wine-x86_64")
os.remove(file)
PY
	then
		# piccoli lanciatori (non collegamenti): Wine trova i suoi file dal percorso vero
		for f in /opt/wine-x86_64/bin/*; do
			printf '#!/bin/sh\nexec %s "$@"\n' "$f" >"/usr/local/bin/$(basename "$f")"
			chmod 755 "/usr/local/bin/$(basename "$f")"
		done
		registro "Wine $WINE_VERSIONE per Intel/AMD installato (con Box64)"
	else
		rm -rf /opt/wine-x86_64
		registro "Wine per ARM non scaricato: i programmi di altri sistemi non saranno disponibili"
	fi
fi

# ── Firewall: Condivisione Vicina ammessa nelle reti di casa/lavoro e nell'hotspot ──
if command -v firewall-offline-cmd >/dev/null; then
	firewall-offline-cmd --set-default-zone=home >/dev/null 2>&1 || true
	for zona in home work nm-shared; do
		firewall-offline-cmd --zone="$zona" --add-service=condivisione-vicina >/dev/null 2>&1 || true
		# Rete nel file manager: scoperta di computer, stampanti e cartelle condivise
		for servizio in mdns samba-client ws-discovery-client; do
			firewall-offline-cmd --zone="$zona" --add-service="$servizio" >/dev/null 2>&1 || true
		done
	done
	registro "firewall configurato"
fi

# ── Tema di icone Colloid (GPL-3.0), versione fissata ──────────────────────────
# Si copiano solo i file delle icone (dati): nessuno script del progetto viene eseguito.
COLLOID_VERSIONE=2026-08-10
D=/usr/share/icons/Colloid-Dark
if apt-get install -y -qq --no-install-recommends git ca-certificates >/tmp/colloid.log 2>&1 \
	&& git clone -q --depth 1 --branch "$COLLOID_VERSIONE" https://github.com/vinceliuice/Colloid-icon-theme.git /tmp/colloid >>/tmp/colloid.log 2>&1; then
	rm -rf "$D" && mkdir -p "$D"
	sed 's/Colloid/Colloid-Dark/g' /tmp/colloid/src/index.theme >"$D/index.theme"
	for cartella in actions apps categories devices emblems mimetypes places status; do
		cp -a "/tmp/colloid/src/$cartella" "$D/"
		[ -d "/tmp/colloid/links/$cartella" ] && cp -a "/tmp/colloid/links/$cartella/." "$D/$cartella/"
	done
	cp -a /tmp/colloid/dark/*.svg "$D/places/scalable/" 2>/dev/null || true
	# Variante chiara (tema chiaro): solo i simboli e le icone piccole, con i colori
	# originali scuri; tutto il resto lo eredita da Colloid-Dark (nessun doppione).
	L=/usr/share/icons/Colloid-Light
	rm -rf "$L" && cp -a "$D" "$L"
	find "$L" \( -type f -o -type l \) -name '*.svg' ! \( -path '*/symbolic/*' -o -path '*/16/*' -o -path '*/22/*' -o -path '*/24/*' -o -path '*/32/*' \) -delete
	find "$L" -xtype l -delete
	find "$L" -type d -empty -delete
	sed -i -e 's/Colloid-Dark/Colloid-Light/g' -e 's/^Inherits=.*/Inherits=Colloid-Dark,Papirus,breeze,hicolor/' "$L/index.theme"
	grep -q '^Inherits=' "$L/index.theme" || sed -i '/^\[Icon Theme\]/a Inherits=Colloid-Dark,Papirus,breeze,hicolor' "$L/index.theme"
	gtk-update-icon-cache -q "$L" 2>/dev/null || true
	# Variante scura: simboli chiari sulle barre scure
	find "$D" -type f -name '*.svg' \( -path '*/symbolic/*' -o -path '*/16/*' -o -path '*/22/*' -o -path '*/24/*' -o -path '*/32/*' \) \
		-exec sed -i 's/#363636/#dedede/g' {} +
	install -m 0644 /tmp/colloid/COPYING "$D/COPYING" 2>/dev/null || install -m 0644 /tmp/colloid/LICENSE "$D/LICENSE" 2>/dev/null || true
	gtk-update-icon-cache -q "$D" 2>/dev/null || true
	registro "icone Colloid $COLLOID_VERSIONE: $(find "$D" -name '*.svg' | wc -l) file"
else
	registro "ATTENZIONE: icone Colloid non scaricate"; tail -n 20 /tmp/colloid.log
fi
rm -rf /tmp/colloid
apt-get purge -y -qq git >/dev/null 2>&1 || true

# ── Tema chiaro: icone del sistema e bordi delle finestre ───────────────────
I=/usr/share/icons/@OS_ID@
if [ -d "$I" ]; then
	mkdir -p "$I-chiaro"
	ln -sfn "$I/scalable" "$I-chiaro/scalable"
	sed -e 's/^Name=.*/Name=@OS_NAME@ Chiaro/' -e 's/^Inherits=.*/Inherits=Colloid-Light,Colloid-Dark,Papirus,breeze,hicolor/' \
		"$I/index.theme" >"$I-chiaro/index.theme"
	gtk-update-icon-cache -q "$I-chiaro" 2>/dev/null || true
fi
T=/usr/share/themes/@OS_NAME@/labwc
C="/usr/share/themes/@OS_NAME@-Chiaro/labwc"
if [ -d "$T" ]; then
	mkdir -p "$C" && cp -a "$T/." "$C/"
	# pulsanti: segni scuri; al passaggio fondo grigio chiaro (la X resta rossa e bianca)
	sed -i -e 's/#E4E4E7/#1D1D1F/g' -e 's/#7C7C84/#A1A1A6/g' -e 's/#3F4048/#E1E1E6/g' "$C"/*.svg
	for f in "$C"/iconify_hover-active.svg "$C"/max_hover-active.svg "$C"/max_toggled_hover-active.svg; do
		[ -f "$f" ] && sed -i 's/#FFFFFF/#1D1D1F/g' "$f"
	done
	sed -i -e 's/#3A3B42/#D1D1D6/g' -e 's/#2C2D33/#E5E5EA/g' -e 's/#2B2C32/#F4F4F6/g' -e 's/#232429/#ECECF0/g' \
		-e 's/#E4E4E7/#1D1D1F/g' -e 's/#7C7C84/#8E8E93/g' -e 's/#26272D/#FFFFFF/g' -e 's/#F5F5F7/#1D1D1F/g' \
		-e 's/#1E1F24/#F4F4F6/g' -e 's/#E6202126/#F2F6F6F8/g' -e 's/#00000080/#00000038/g' -e 's/#00000050/#00000024/g' \
		-e 's/title.separator.color: #000000/title.separator.color: #E5E5EA/' "$C/themerc"
fi

# ── Protocollo Wayland delle finestre (dock e barra della shell) ─────────────
WL=/usr/lib/python3/dist-packages/nucleo/wl
if apt-get install -y -qq --no-install-recommends libwayland-dev pkg-config >/tmp/wl.log 2>&1; then
	rm -rf "$WL" && mkdir -p "$WL"
	if python3 -m pywayland.scanner -o "$WL" -i /usr/share/wayland/wayland.xml \
		/usr/share/nucleo/protocolli/wlr-foreign-toplevel-management-unstable-v1.xml >>/tmp/wl.log 2>&1; then
		touch "$WL/__init__.py"
		python3 -c "import nucleo.wl.wlr_foreign_toplevel_management_unstable_v1 as m; print(m.ZwlrForeignToplevelManagerV1)" >>/tmp/wl.log 2>&1 \
			&& registro "protocollo delle finestre generato" || { registro "ATTENZIONE: modulo delle finestre non importabile"; tail -n 20 /tmp/wl.log; }
		python3 -m compileall -q "$WL" >/dev/null 2>&1 || true
	else
		registro "ATTENZIONE: pywayland-scanner non riuscito"; tail -n 20 /tmp/wl.log
	fi
	apt-get purge -y -qq libwayland-dev >/dev/null 2>&1 || true
else
	registro "ATTENZIONE: libwayland-dev non installabile"; tail -n 20 /tmp/wl.log
fi

# ── QML precompilato: le app si aprono senza compilare l'interfaccia ──────────
if /usr/libexec/nucleo/precompila-qml >/tmp/qml.log 2>&1; then
	registro "$(tail -n 1 /tmp/qml.log)"
	chmod -R a+rX /var/cache/nucleo
else
	registro "ATTENZIONE: precompilazione QML non riuscita"; tail -n 15 /tmp/qml.log
fi
grep -q QML_DISK_CACHE_PATH /etc/environment 2>/dev/null || echo "QML_DISK_CACHE_PATH=/var/cache/nucleo/qml" >>/etc/environment

# ── File manager: «Comprimi» ed «Estrai qui» con l'app Archivi ──────────────
for elenco in /usr/share/libfm-qt*/archivers.list; do
	[ -f "$elenco" ] || continue
	grep -q '^\[@OS_ID@-archivi\]' "$elenco" || cat >>"$elenco" <<'FINE'

[@OS_ID@-archivi]
create=@OS_ID@-archivi --comprimi %U
extract=@OS_ID@-archivi --estrai %U
extract_to=@OS_ID@-archivi --estrai-in %d %U
mime_types=application/zip;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/gzip;application/x-cd-image;
supports_uris=false
FINE
done

# ── Menu delle app: nomi semplici e niente voci tecniche o doppie ─────────────
A=/usr/share/applications
rinomina() { # file nome
	[ -f "$A/$1" ] || return 0
	sed -i -e "/^Name\[it\]=/d" -e "0,/^Name=.*/s//Name=$2/" "$A/$1"
}
rinomina firefox-esr.desktop "Firefox"
rinomina qterminal.desktop "Terminale"
for voce in pcmanfm-qt.desktop calamares.desktop install-debian.desktop wine.desktop wine-*.desktop debian-xterm.desktop debian-uxterm.desktop \
	xterm.desktop uxterm.desktop pcmanfm-qt-desktop-pref.desktop qterminal-drop.desktop avahi-discover.desktop bssh.desktop \
	bvnc.desktop lxqt-*.desktop org.kde.*.desktop nm-applet.desktop display-im*.desktop; do
	for f in $A/$voce; do
		[ -f "$f" ] && ! grep -q '^NoDisplay=true' "$f" && sed -i 's/^\[Desktop Entry\]$/[Desktop Entry]\nNoDisplay=true/' "$f"
	done
done
# Programmi da terminale (Vim, htop, …) e strumenti tecnici: non servono a chi usa il computer
# tutti i giorni (da altri sistemi operativi). Restano installati e si avviano dal Terminale.
for f in $A/*.desktop; do
	[ -f "$f" ] || continue
	case "$(basename "$f")" in @OS_ID@-*|firefox*|qterminal.desktop) continue ;; esac
	if grep -qi '^Terminal=true' "$f"; then
		grep -q '^NoDisplay=true' "$f" || sed -i 's/^\[Desktop Entry\]$/[Desktop Entry]\nNoDisplay=true/' "$f"
	fi
done
for voce in vim.desktop gvim.desktop nvim.desktop htop.desktop btop.desktop nvtop.desktop python3*.desktop ipython*.desktop \
	im-config.desktop gparted.desktop pavucontrol*.desktop nm-connection-editor.desktop blueman-*.desktop \
	system-config-printer.desktop org.freedesktop.*.desktop yelp.desktop mpv.desktop vlc.desktop libfm-pref-apps.desktop \
	lstopo.desktop kbd*.desktop debian-*.desktop xdg-*.desktop org.gnome.Software*.desktop software-properties*.desktop \
	gcr-*.desktop gnome-*-panel.desktop zenity*.desktop wpa_gui.desktop; do
	for f in $A/$voce; do
		[ -f "$f" ] && ! grep -q '^NoDisplay=true' "$f" && sed -i 's/^\[Desktop Entry\]$/[Desktop Entry]\nNoDisplay=true/' "$f"
	done
done
registro "menu delle app ripulito"

# ── Servizi ───────────────────────────────────────────────────────────────────
systemctl enable nucleo-profilo.service >/dev/null 2>&1 || true
systemctl enable nucleo-autotest.service >/dev/null 2>&1 || true
systemctl enable plocate-updatedb.timer >/dev/null 2>&1 || true
systemctl disable cups-browsed.service >/dev/null 2>&1 || true
# Leggerezza: servizi avviati solo quando servono, niente controlli inutili
systemctl disable cups.service >/dev/null 2>&1 || true        # parte da cups.socket alla prima stampa
systemctl enable cups.socket cups.path >/dev/null 2>&1 || true
systemctl disable netavark-dhcp-proxy.service netavark-firewalld-reload.service >/dev/null 2>&1 || true
systemctl disable xfs_scrub_all.timer e2scrub_all.timer >/dev/null 2>&1 || true
systemctl enable earlyoom.service >/dev/null 2>&1 || true

# ── Pulizia ───────────────────────────────────────────────────────────────────
apt-get clean
exit 0
