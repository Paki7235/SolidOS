[Unit]
Description=Collegamento AWDL per AirDrop (OWL) — BETA
After=network.target

[Service]
EnvironmentFile=/run/nucleo/owl.env
ExecStart=/usr/local/bin/owl -i ${OWL_INTERFACCIA} -c ${OWL_CANALE}
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
