#!/bin/bash
# Prova automatica delle app (solo con il parametro di avvio @OS_ID@.autotest).
# Apre ogni app nella sessione grafica dell'utente live, controlla che resti
# aperta, ne salva una schermata e scrive risultati e immagini sulla seconda
# porta seriale (/dev/ttyS1), letta dalla macchina virtuale di prova.
set -u
USCITA=/dev/ttyS1
UTENTE=@OS_ID@
scrivi() { printf '%s\n' "$*" >"$USCITA"; }

UID_U=$(id -u "$UTENTE") || exit 1
RUN=/run/user/$UID_U
STATO=/home/$UTENTE/.local/state/@OS_ID@
for _ in $(seq 120); do
	PID_LABWC=$(pgrep -u "$UTENTE" -x labwc | head -1)
	[ -n "$PID_LABWC" ] && [ -S "$RUN/wayland-0" ] && break
	sleep 2
done
[ -n "${PID_LABWC:-}" ] || { scrivi "AUTOTEST ERRORE labwc non avviato"; exit 1; }
sleep 25 # lascia finire l'avvio della sessione

AMBIENTE=()
while IFS= read -r -d '' v; do AMBIENTE+=("$v"); done <"/proc/$PID_LABWC/environ"
AMBIENTE+=(WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR="$RUN" DBUS_SESSION_BUS_ADDRESS="unix:path=$RUN/bus")
come_utente() { runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" "$@"; }

immagine() { # NOME
	local f=/tmp/autotest-$1.png
	if ! come_utente grim -t png -l 9 -s 0.5 "$f" 2>/tmp/autotest-grim.err; then
		scrivi "AUTOTEST-LOG grim: $(head -c 300 /tmp/autotest-grim.err | tr '\n' ' ')"
		return
	fi
	scrivi "AUTOTEST-IMG $1 $(base64 -w0 "$f")"
	rm -f "$f"
}

scrivi "AUTOTEST INIZIO $(date -Is) RAM: $(free -m | awk '/^Mem/{print $3"MB usati su "$2}')"
immagine 00-desktop
# App aperta dal dock (tramite la shell): deve essere una finestra normale,
# con titolo e pulsanti, non un pannello di sistema a tutto schermo
come_utente @OS_ID@-ctl apri @OS_ID@-impostazioni; sleep 16
if grep -q '"appId": "@OS_ID@-impostazioni"' "$STATO/finestre.json" 2>/dev/null; then
	scrivi "AUTOTEST-DOCK finestra normale: OK"
else
	scrivi "AUTOTEST-DOCK ERRORE: l'app aperta dal dock non è una finestra normale"
fi
immagine 02-dal-dock
pkill -u "$UTENTE" -f 'nucleo.impostazioni' 2>/dev/null; sleep 2

pkill -u "$UTENTE" -f 'nucleo.benvenuto' 2>/dev/null; sleep 2   # la finestra di benvenuto coprirebbe la scrivania
# ── Scrivania con clic veri: il mouse virtuale di QEMU esegue le richieste «AUTOTEST-MOUSE» ──
mouse() { scrivi "AUTOTEST-MOUSE $*"; sleep 4; }
come_utente python3 -c "from nucleo.shell import scrivania; print(scrivania.aggiungi_collegamento('@OS_ID@-calcolatrice'))" >/dev/null 2>&1
sleep 4
immagine scrivania-collegamento
# primo posto della griglia (icone medie, barra in alto): centro a 60,93
mouse 60 93 doppio
sleep 6
if grep -q '"appId": "@OS_ID@-calcolatrice"' "$STATO/finestre.json" 2>/dev/null; then
	scrivi "AUTOTEST-SCRIVANIA collegamento aperto con doppio clic: OK"
else
	scrivi "AUTOTEST-SCRIVANIA ERRORE: il doppio clic sul collegamento non ha aperto l'app"
fi
immagine scrivania-doppio-clic
pkill -u "$UTENTE" -f 'nucleo.apps.calcolatrice' 2>/dev/null; sleep 2
mouse 640 420 destro
immagine scrivania-menu
mouse esc 0 tasto
mouse 60 93 destro
immagine scrivania-menu-icona
mouse esc 0 tasto
# Barra unica in basso (stile Windows) e tema chiaro
come_utente python3 -c "from nucleo.impostazioni.pannelli_aspetto import PannelloPannello as P; P().imposta('barra', 'windows')" >/dev/null 2>&1
sleep 5
immagine barra-windows
come_utente python3 -c "from nucleo.impostazioni.pannelli_aspetto import PannelloAspetto as P; P().imposta('tema', 'chiaro')" >/dev/null 2>&1
sleep 5
setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" @OS_ID@-file >/dev/null 2>&1 &
sleep 7
immagine tema-chiaro-file
pkill -u "$UTENTE" -f 'nucleo.apps.file' 2>/dev/null; sleep 1
come_utente @OS_ID@-ctl start >/dev/null 2>&1; sleep 3
immagine tema-chiaro-start
come_utente @OS_ID@-ctl start >/dev/null 2>&1; sleep 1
come_utente python3 -c "from nucleo.impostazioni.pannelli_aspetto import PannelloAspetto as P, PannelloPannello as Q; P().imposta('tema', 'scuro'); Q().imposta('barra', 'mac')" >/dev/null 2>&1
sleep 4
# Impostazioni: ogni pannello deve leggere le sue voci senza errori (e ne salva una foto)
come_utente python3 - >"$USCITA" 2>&1 <<'PY'
import time, traceback
from nucleo.impostazioni import PANNELLI
for cls in PANNELLI:
    inizio = time.monotonic()
    try:
        voci = cls().voci()
        errori = [v for v in voci if v.get("id") == "errore" or "Impossibile" in str(v.get("titolo", ""))]
        stato = "ERRORE " + str(errori[0].get("valore")) if errori else "OK"
        print(f"AUTOTEST-IMPOSTAZIONI {cls.id}: {stato} ({len(voci)} voci, {time.monotonic() - inizio:.1f} s)")
    except Exception as e:
        print(f"AUTOTEST-IMPOSTAZIONI {cls.id}: ECCEZIONE {type(e).__name__}: {e}")
        print("AUTOTEST-IMPOSTAZIONI-TRACCIA " + traceback.format_exc().replace(chr(10), " | ")[-600:])
PY
for pannello in rete bluetooth condivisione schermo audio energia tastiera mouse aspetto pannello notifiche spazi utenti privacy aggiornamenti snapshot lingua dataora informazioni archiviazione; do
	setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" @OS_ID@-impostazioni "$pannello" >/dev/null 2>&1 &
	pid=$!; sleep 5
	immagine "impostazioni-$pannello"
	pkill -KILL -s "$pid" 2>/dev/null; pkill -KILL -u "$UTENTE" -f 'nucleo.impostazioni' 2>/dev/null; sleep 1
done

# Menu Start (logo o tasto Super)
come_utente @OS_ID@-ctl start; sleep 3; immagine 01-start; come_utente @OS_ID@-ctl start; sleep 1

# Stato della shell e dei servizi utente (per i pulsanti del pannello)
come_utente busctl --user list --no-pager 2>&1 | grep -i '@OS_ID@' | sed 's/^/AUTOTEST-BUS /' >"$USCITA"
for f in shell.log sessione.log; do
	[ -f "$STATO/$f" ] && tail -n 25 "$STATO/$f" | sed "s/^/AUTOTEST-$f: /" >"$USCITA"
done
come_utente systemctl --user --failed --no-legend --no-pager 2>&1 | sed 's/^/AUTOTEST-FALLITO /' >"$USCITA"
pgrep -u "$UTENTE" -af 'nucleo|lxqt|swaybg|swayidle' | sed 's/^/AUTOTEST-PROC /' >"$USCITA"

# Elenco: app del sistema + app di base del menu
ELENCO=()
for f in /usr/share/applications/@OS_ID@-*.desktop /usr/share/applications/{firefox-esr,qterminal}.desktop; do
	[ -f "$f" ] || continue
	case $f in *-riavvia.desktop|*-spegni.desktop|*-installa-sistema.desktop|*-benvenuto.desktop) continue ;; esac
	ELENCO+=("$f")
done

# Chiude la finestra di benvenuto aperta all'avvio
pkill -u "$UTENTE" -f 'nucleo.benvenuto' 2>/dev/null; sleep 2

for f in "${ELENCO[@]}"; do
	nome=$(basename "$f" .desktop)
	cmd=$(grep -m1 '^Exec=' "$f" | cut -d= -f2- | sed 's/ %[a-zA-Z]//g')
	log=/tmp/autotest-$nome.log
	# setsid in testa: l'app e i suoi figli stanno in una sessione propria,
	# chiusa alla fine senza toccare questo script
	setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" sh -c "$cmd" >"$log" 2>&1 &
	pid=$!
	sleep 12
	if kill -0 "$pid" 2>/dev/null || pgrep -u "$UTENTE" -f "$(echo "$cmd" | awk '{print $1}')" >/dev/null; then
		stato=APERTA
	else
		wait "$pid"; stato="CHIUSA(codice $?)"
	fi
	scrivi "AUTOTEST-APP $nome | $cmd | $stato"
	grep -aiE 'error|errore|traceback|exception|is not a type|not installed|cannot|unable|failed|referenceerror|typeerror|module .* not' "$log" \
		| grep -v 'qt.qpa.wayland: Wayland does not support QWindow::requestActivate' | head -25 \
		| sed "s/^/AUTOTEST-LOG $nome: /" >"$USCITA"
	[ "$stato" = APERTA ] || tail -n 15 "$log" | sed "s/^/AUTOTEST-CODA $nome: /" >"$USCITA"
	immagine "$nome"
	[ -f "$STATO/finestre.json" ] && scrivi "AUTOTEST-FINESTRE $nome: $(head -c 600 "$STATO/finestre.json")"
	# I pannelli della shell si aprono e chiudono con lo stesso comando
	case $cmd in *-ctl\ *|*-barra) come_utente sh -c "$cmd" >/dev/null 2>&1 ;; esac
	pkill -KILL -s "$pid" 2>/dev/null
	pkill -KILL -u "$UTENTE" -f "$(echo "$cmd" | awk '{print $1}')" 2>/dev/null
	sleep 2
done

# ── Galleria: tutto anche col tema chiaro, e con la barra stile Windows ──────
aspetto() { come_utente python3 -c "from nucleo.impostazioni.pannelli_aspetto import PannelloAspetto as P, PannelloPannello as Q; P().imposta('tema', '$1'); Q().imposta('barra', '$2')" >/dev/null 2>&1; sleep 5; }
pannelli_shell() { # PREFISSO
	immagine "$1-scrivania"
	come_utente @OS_ID@-ctl start; sleep 3; immagine "$1-start"; come_utente @OS_ID@-ctl start; sleep 1
	come_utente @OS_ID@-ctl controllo; sleep 3; immagine "$1-centro-controllo"; come_utente @OS_ID@-ctl controllo; sleep 1
	come_utente @OS_ID@-ctl notifiche; sleep 3; immagine "$1-notifiche"; come_utente @OS_ID@-ctl notifiche; sleep 1
}
# Dimensione delle icone (Impostazioni › Barra e Dock): deve cambiare davvero
lato() { come_utente python3 -c "from nucleo.impostazioni.pannelli_aspetto import PannelloPannello as Q; Q().imposta('dockLato', '$1')" >/dev/null 2>&1; sleep 4; }
lato 56; immagine icone-grandi-mac; lato 40; immagine icone-piccole-mac; lato 48
aspetto scuro windows; lato 56; immagine icone-grandi-windows; lato 40; immagine icone-piccole-windows; lato 48
aspetto scuro windows; pannelli_shell scuro-windows
aspetto chiaro windows; pannelli_shell chiaro-windows
aspetto chiaro mac; pannelli_shell chiaro-mac
for f in "${ELENCO[@]}"; do
	nome=$(basename "$f" .desktop)
	cmd=$(grep -m1 '^Exec=' "$f" | cut -d= -f2- | sed 's/ %[a-zA-Z]//g')
	case $cmd in *-ctl\ *|*-barra) continue ;; esac
	setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" sh -c "$cmd" >/dev/null 2>&1 &
	pid=$!
	sleep 9
	immagine "chiaro-$nome"
	pkill -KILL -s "$pid" 2>/dev/null
	pkill -KILL -u "$UTENTE" -f "$(echo "$cmd" | awk '{print $1}')" 2>/dev/null
	sleep 2
done
aspetto scuro mac
scrivi "AUTOTEST-GALLERIA fatta"

# ── Schermata di accesso (stile Mac) vista dentro la sessione ─────────────────
setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" python3 -m nucleo.greeter >/tmp/autotest-greeter.log 2>&1 &
pid=$!; sleep 12; immagine accesso
grep -aiE 'error|traceback|referenceerror|typeerror' /tmp/autotest-greeter.log | head -15 | sed 's/^/AUTOTEST-LOG greeter: /' >"$USCITA"
pkill -KILL -s "$pid" 2>/dev/null; pkill -KILL -u "$UTENTE" -f 'nucleo.greeter' 2>/dev/null; sleep 2

# ── File › Rete: dispositivi collegati alla stessa rete ──────────────────────
come_utente timeout 30 python3 -m nucleo.dispositivi_rete 2>&1 | head -20 | sed 's/^/AUTOTEST-RETE /' >"$USCITA"
setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" @OS_ID@-file network:/// >/tmp/autotest-rete.log 2>&1 &
pid=$!; sleep 15; immagine file-rete
grep -aiE 'error|traceback|referenceerror|typeerror' /tmp/autotest-rete.log | head -15 | sed 's/^/AUTOTEST-LOG file-rete: /' >"$USCITA"
pkill -KILL -s "$pid" 2>/dev/null; pkill -KILL -u "$UTENTE" -f 'nucleo.apps.file' 2>/dev/null; sleep 2

# ── Terminale: comandi di Windows e del Mac ─────────────────────────────────
come_utente bash -ic 'cd /etc; dir /b | head -3; DIR /b | head -2; ver; sw_vers; ipconfig | head -3; where ls; type ls; Get-ChildItem /usr | head -2; comandi | head -3' 2>&1 \
	| grep -v 'no job control\|cannot set terminal' | head -30 | sed 's/^/AUTOTEST-TERM /' >"$USCITA"

# ── Solid ID e Dov'è: collegamento a Supabase, regole di sicurezza, mappa ────
come_utente python3 -c "
from nucleo import solidid
print('configurato', solidid.disponibile(), 'collegato', solidid.collegato())
try:
    print('anonimo vede:', solidid._richiesta('GET', '/rest/v1/dispositivi?select=id'))
except solidid.ErroreSolidID as e:
    print('anonimo bloccato:', e)
from nucleo.solidid.posizione import trova
p = trova(); print('posizione trovata:', bool(p), (p or {}).get('fonte'))
" 2>&1 | head -8 | sed 's/^/AUTOTEST-SOLIDID /' >"$USCITA"
cat >/usr/share/nucleo/qml/Dove/ProvaMappa.qml <<'FINE'
import QtQuick
import QtQuick.Window
Window {
    visible: true; width: 760; height: 480; title: "Prova mappa"
    Mappa {
        anchors.fill: parent; lat: 41.8986; lon: 12.4769; zoom: 14
        segnaposti: [{ id: "a", lat: 41.8986, lon: 12.4769, nome: "Portatile di prova", icona: "computer-laptop", precisione: 120, scelto: true },
                     { id: "b", lat: 41.9028, lon: 12.4964, nome: "Telefono", icona: "phone", precisione: 0, scelto: false }]
    }
}
FINE
setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" python3 -c "from nucleo.apps.dove import BackendDove; from nucleo.ponte import crea_ponte; from nucleo.qmlapp import esegui_app; esegui_app('dove', 'Dove/ProvaMappa.qml', lambda a: {'ponte': crea_ponte(BackendDove())})" >/tmp/autotest-mappa.log 2>&1 &
pid=$!; sleep 15; immagine mappa
grep -aiE 'error|traceback|referenceerror|typeerror|not a type' /tmp/autotest-mappa.log | head -10 | sed 's/^/AUTOTEST-LOG mappa: /' >"$USCITA"
pkill -KILL -s "$pid" 2>/dev/null; sleep 2

# ── Simbolo del Wi-Fi (ventaglio) a ogni livello, chiaro e scuro ─────────────
cat >/usr/share/nucleo/qml/Shell/ProvaWifi.qml <<'FINE'
import QtQuick
import QtQuick.Window
Window {
    visible: true; width: 520; height: 150; color: "#20232B"; title: "Prova Wi-Fi"
    Column {
        anchors.centerIn: parent; spacing: 18
        Repeater {
            model: ["#FFFFFF", "#111111"]
            Rectangle {
                required property string modelData
                width: 480; height: 46; radius: 8; color: modelData === "#FFFFFF" ? "#2B2F3A" : "#F2F2F5"
                Row {
                    anchors.centerIn: parent; spacing: 34
                    Repeater {
                        model: [[false, 0], [true, 10], [true, 30], [true, 60], [true, 90]]
                        SegnaleWifi { required property var modelData; connesso: modelData[0]; percento: modelData[1]; colore: parent.parent.modelData; scale: 2 }
                    }
                }
            }
        }
    }
}
FINE
setsid runuser -u "$UTENTE" -- env "${AMBIENTE[@]}" python3 -c "from nucleo.qmlapp import esegui_app; esegui_app('prova-wifi', 'Shell/ProvaWifi.qml')" >/tmp/autotest-wifi.log 2>&1 &
pid=$!; sleep 8; immagine wifi
grep -aiE 'error|traceback|referenceerror|typeerror|not a type' /tmp/autotest-wifi.log | head -10 | sed 's/^/AUTOTEST-LOG wifi: /' >"$USCITA"
pkill -KILL -s "$pid" 2>/dev/null; sleep 2

# ── Schermata di blocco (ultima prova: dopo resta bloccato) ─────────────────
come_utente python3 -m nucleo.blocco --prepara 2>&1 | head -5 | sed 's/^/AUTOTEST-BLOCCO /' >"$USCITA"
come_utente python3 -m nucleo.blocco >/tmp/autotest-blocco.log 2>&1
sleep 6; immagine blocco
head -c 1500 /tmp/autotest-blocco.log | sed 's/^/AUTOTEST-LOG blocco: /' >"$USCITA"
pgrep -u "$UTENTE" -x gtklock >/dev/null && scrivi "AUTOTEST-BLOCCO gtklock attivo: OK" || scrivi "AUTOTEST-BLOCCO ERRORE: gtklock non è partito"

scrivi "AUTOTEST RAM finale: $(free -m | awk '/^Mem/{print $3"MB usati su "$2}')"
ps -eo rss=,comm= --sort=-rss | head -15 | awk '{printf "AUTOTEST-MEM %d MB %s\n", $1/1024, $2}' >"$USCITA"
scrivi "AUTOTEST FINE"
