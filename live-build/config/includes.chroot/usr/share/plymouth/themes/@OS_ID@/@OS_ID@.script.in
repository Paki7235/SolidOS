# Schermata di avvio di @OS_NAME@: logo al centro che "respira" lentamente.
# Nessun testo (non servono font nell'initramfs).

Window.SetBackgroundTopColor(@COLORE_SFONDO_SCURO_R@, @COLORE_SFONDO_SCURO_G@, @COLORE_SFONDO_SCURO_B@);
Window.SetBackgroundBottomColor(@COLORE_SFONDO_SCURO_R@, @COLORE_SFONDO_SCURO_G@, @COLORE_SFONDO_SCURO_B@);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20);
logo.sprite.SetZ(10);

tempo = 0;

fun aggiorna() {
	tempo++;
	logo.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(tempo / 18));
}

Plymouth.SetRefreshFunction(aggiorna);

# Allo spegnimento il logo resta fermo e pieno
fun spegnimento() {
	logo.sprite.SetOpacity(1);
}
if (Plymouth.GetMode() == "shutdown") {
	Plymouth.SetRefreshFunction(spegnimento);
}
