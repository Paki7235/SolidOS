<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>@OS_NAME@</vendor>
  <action id="org.@OS_ID@.airdrop">
    <description>Attivare il collegamento AirDrop (AWDL)</description>
    <message>Per attivare AirDrop serve l'autorizzazione</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nucleo/airdrop-awdl</annotate>
  </action>
</policyconfig>
