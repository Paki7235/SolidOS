<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>@OS_NAME@</vendor>
  <action id="org.@OS_ID@.helper">
    <description>Operazioni di amministrazione di @OS_NAME@</description>
    <message>Per continuare serve la password di un amministratore</message>
    <icon_name>@OS_ID@-logo</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nucleo/helper</annotate>
  </action>
</policyconfig>
