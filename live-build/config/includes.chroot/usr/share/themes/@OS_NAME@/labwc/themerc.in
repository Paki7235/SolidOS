# Tema delle finestre di @OS_NAME@ per labwc: grafite neutro; pulsanti chiari
# a destra: riduci, ingrandisci, chiudi (rosso al passaggio).

border.width: 0
padding.height: 8
padding.width: 6
window.button.width: 34
window.button.spacing: 2
window.label.text.justify: left
window.active.shadow.size: 36
window.inactive.shadow.size: 20
window.active.shadow.color: #00000080
window.inactive.shadow.color: #00000050

window.active.border.color: #3A3B42
window.inactive.border.color: #2C2D33
window.active.title.bg.color: #2B2C32
window.inactive.title.bg.color: #232429
window.active.title.separator.color: #000000
window.inactive.title.separator.color: #000000
window.active.label.text.color: #E4E4E7
window.inactive.label.text.color: #7C7C84
window.active.button.unpressed.image.color: #E4E4E7
window.inactive.button.unpressed.image.color: #7C7C84
window.active.handle.bg.color: #2B2C32

menu.border.width: 1
menu.border.color: #3A3B42
menu.items.bg.color: #26272D
menu.items.text.color: #F5F5F7
menu.items.active.bg.color: @COLORE_ACCENTO@
menu.items.active.text.color: #FFFFFF
menu.items.padding.x: 12
menu.items.padding.y: 5
menu.separator.color: #3A3B42
menu.title.bg.color: #1E1F24
menu.title.text.color: #F5F5F7

osd.bg.color: #E6202126
osd.border.color: #3A3B42
osd.border.width: 1
osd.label.text.color: #F5F5F7
osd.window-switcher.item.active.border.color: @COLORE_ACCENTO@
