# Installer di @OS_NAME@ (Calamares)
---
modules-search: [ local, /usr/lib/@ARCH_TRIPLETTA@/calamares/modules ]

instances:
- id:       pulizia-live
  module:   shellprocess
  config:   shellprocess_pulizia.conf
- id:       sistema
  module:   shellprocess
  config:   shellprocess_sistema.conf
- id:       utente
  module:   shellprocess
  config:   shellprocess_utente.conf

# Si sceglie solo il disco: lingua, tastiera e fuso orario sono già quelli del sistema,
# l'account si crea da solo e si personalizza al primo avvio (Benvenuto)
sequence:
- show:
  - partition
  - summary
- exec:
  - partition
  - mount
  - unpackfs
  - machineid
  - fstab
  - networkcfg
  - hwclock
  - shellprocess@utente
  - shellprocess@pulizia-live
  - initramfscfg
  - initramfs
  - grubcfg
  - bootloader
  - shellprocess@sistema
  - umount
- show:
  - finished

branding: @OS_ID@
prompt-install: true
dont-chroot: false
oem-setup: false
disable-cancel: false
disable-cancel-during-exec: true
hide-back-and-next-during-exec: true
quit-at-end: false
