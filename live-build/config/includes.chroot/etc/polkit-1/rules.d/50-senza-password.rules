// Account senza password (all'accesso basta Invio): come sul Mac, le operazioni di
// amministrazione non aprono una richiesta di password vuota. Chi sceglie una password
// esce dal gruppo «senzapassword» e da quel momento gli viene chiesta.
polkit.addRule(function (action, subject) {
    if (subject.isInGroup("senzapassword") && subject.isInGroup("sudo") && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
