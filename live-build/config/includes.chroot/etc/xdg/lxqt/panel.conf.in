# Pannello provvisorio della Fase 1 (lxqt-panel in basso, stile Windows).
[General]
__userfile__=true

[panel1]
alignment=-1
animation-duration=0
desktop=0
hidable=false
iconSize=24
lineCount=1
lockPanel=true
panelSize=44
plugins=mainmenu, quicklaunch, taskbar, statusnotifier, quicklaunch2, worldclock, showdesktop
position=Bottom
reserve-space=true
visible-margin=true
width=100
width-percent=true

[mainmenu]
type=mainmenu
ownIcon=true
icon=/usr/share/@OS_ID@/logo.svg
showText=false
filterMenu=true
filterShow=true

[quicklaunch]
type=quicklaunch
apps\1\desktop=/usr/share/applications/pcmanfm-qt.desktop
apps\2\desktop=/usr/share/applications/firefox-esr.desktop
apps\3\desktop=/usr/share/applications/@OS_ID@-store.desktop
apps\4\desktop=/usr/share/applications/@OS_ID@-impostazioni.desktop
apps\size=4

[taskbar]
type=taskbar
buttonStyle=Icon
groupingEnabled=true
showOnlyOneDesktopTasks=true

[statusnotifier]
type=statusnotifier

[quicklaunch2]
type=quicklaunch
apps\1\desktop=/usr/share/applications/@OS_ID@-centro-controllo.desktop
apps\2\desktop=/usr/share/applications/@OS_ID@-centro-notifiche.desktop
apps\size=2

[worldclock]
type=worldclock
timeZones\1\timeZone=local
timeZones\size=1

[showdesktop]
type=showdesktop
