<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu del tasto destro sul desktop e del tasto Super (provvisorio, Fase 1). -->
<openbox_menu>
  <menu id="root-menu" label="@OS_NAME@">
    <item label="@T_MENU_FILE@"><action name="Execute" command="@OS_ID@-file" /></item>
    <item label="@T_MENU_BROWSER@"><action name="Execute" command="firefox-esr" /></item>
    <item label="@T_MENU_TERMINALE@"><action name="Execute" command="qterminal" /></item>
    <item label="@T_MENU_EDITOR@"><action name="Execute" command="@OS_ID@-testo" /></item>
    <separator />
    <item label="@T_MENU_ESCI@"><action name="Exit" /></item>
    <item label="@T_MENU_RIAVVIA@"><action name="Execute" command="systemctl reboot" /></item>
    <item label="@T_MENU_SPEGNI@"><action name="Execute" command="systemctl poweroff" /></item>
  </menu>
</openbox_menu>
