# Avvio automatico della sessione @OS_NAME@ (eseguito da labwc con sh).

# Rende visibile l'ambiente Wayland ai servizi avviati via D-Bus/systemd
dbus-update-activation-environment --systemd \
	WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
	QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE GRAFICA_SICURA \
	>/dev/null 2>&1

# Sfondo e icone della scrivania: li disegna la shell (finestra di sfondo)

# Shell (notifiche, centro di controllo, OSD) e pannello
@OS_ID@-shell >"${XDG_STATE_HOME:-$HOME/.local/state}/@OS_ID@/shell.log" 2>&1 &
# Barra in alto e dock sono disegnati dalla shell (@OS_ID@-shell)
lxqt-policykit-agent >/dev/null 2>&1 &

# Blocco automatico dopo 10 minuti e prima della sospensione
swayidle -w timeout 600 'swaylock -f' before-sleep 'swaylock -f' >/dev/null 2>&1 &

# Servizi utente: Condivisione Vicina, Spazi, registro privacy
systemctl --user start @OS_ID@-privacy.service >/dev/null 2>&1 &
# Condivisione Vicina: all'accesso solo se è visibile ad altri; altrimenti parte
# da sola alla prima richiesta (attivazione D-Bus), così non occupa memoria.
CONF_CONDIVISIONE="${XDG_CONFIG_HOME:-$HOME/.config}/@OS_ID@/condivisione.json"
if [ -f "$CONF_CONDIVISIONE" ] && ! grep -q '"visibilita": *"nessuno"' "$CONF_CONDIVISIONE" && grep -q '"visibilita"' "$CONF_CONDIVISIONE"; then
	systemctl --user start @OS_ID@-condivisione.service >/dev/null 2>&1 &
fi

xdg-user-dirs-update >/dev/null 2>&1
/usr/libexec/@OS_ID@/avvisi-avvio >/dev/null 2>&1 &
@OS_ID@-spazi ripristina >/dev/null 2>&1 &
/usr/libexec/nucleo/primo-accesso >/dev/null 2>&1 &
