# Impostazioni iniziali del file manager di @OS_NAME@ (l'utente può cambiarle dalle preferenze).
[System]
Archiver=@OS_ID@-archivi
Terminal=qterminal
SuCommand=pkexec %s
FallbackIconThemeName=@TEMA_ICONE@

[Behavior]
SingleClick=false
ConfirmDelete=true
UseTrash=true
AutoRun=true
QuickExec=false

[Desktop]
ShowWmMenu=false

[FolderView]
Mode=icon
ShowHidden=false
SortCaseSensitive=false
SortFolderFirst=true
BigIconSize=48
SmallIconSize=24
SidePaneIconSize=20
ThumbnailIconSize=128
ShowThumbnails=true

[Places]
PlacesApplications=false
PlacesComputer=true
PlacesDesktop=true
PlacesHome=true
PlacesNetwork=true
PlacesRoot=false
PlacesTrash=true

[Window]
AlwaysShowTabs=false
ShowMenuBar=false
SidePaneMode=places
