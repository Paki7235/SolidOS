# Menu di avvio UEFI di @OS_NAME@ @OS_VERSION@ (generato: non modificare a mano)
# %KERNEL% e %INITRD% vengono completati dall'hook 9000-menu-avvio.

set default=0
set timeout=@TIMEOUT_MENU_AVVIO@
set timeout_style=menu

insmod part_gpt
insmod part_msdos
insmod all_video
insmod gfxterm
insmod png
insmod font

if loadfont /boot/grub/font.pf2 ; then
	set gfxmode=auto
	set gfxpayload=keep
	terminal_output gfxterm
fi

loadfont /boot/grub/@OS_ID@/font-12.pf2
loadfont /boot/grub/@OS_ID@/font-16.pf2
if [ -f /boot/grub/@OS_ID@/theme.txt ] && [ "$gfxmode" = "auto" ] ; then
	set theme=/boot/grub/@OS_ID@/theme.txt
	export theme
elif background_image -m stretch /boot/grub/@OS_ID@/sfondo.png ; then
	set color_normal=light-gray/black
	set menu_color_normal=light-gray/black
	set menu_color_highlight=black/light-gray
else
	set menu_color_normal=white/black
	set menu_color_highlight=black/light-gray
fi

menuentry "@T_AVVIO_INSTALLA@" --id installa {
	linux /live/%KERNEL% @KERNEL_PARAMETRI_LIVE@ @OS_ID@.installa=1
	initrd /live/%INITRD%
}

menuentry "@T_AVVIO_INSTALLA_SICURA@" --id installa-sicura {
	linux /live/%KERNEL% @KERNEL_PARAMETRI_LIVE@ @OS_ID@.installa=1 @OS_ID@.grafica=sicura
	initrd /live/%INITRD%
}

if [ "$grub_platform" = "efi" ]; then
	menuentry "@T_AVVIO_DISCO@" --id disco {
		exit
	}
	menuentry "@T_AVVIO_FIRMWARE@" --id firmware {
		fwsetup
	}
fi

menuentry "@T_AVVIO_SPEGNI@" --id spegni {
	halt
}
