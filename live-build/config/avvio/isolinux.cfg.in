# Menu di avvio BIOS di @OS_NAME@ @OS_VERSION@ (generato: non modificare a mano)
# Lo schermo è 80x30 caratteri su 640x480: il menu parte sotto logo e nome.
UI vesamenu.c32
PROMPT 0
TIMEOUT @TIMEOUT_MENU_AVVIO@0
DEFAULT installa

MENU TITLE
MENU BACKGROUND splash.png
MENU RESOLUTION 640 480
MENU VSHIFT 8
MENU HSHIFT 15
MENU WIDTH 50
MENU MARGIN 2
MENU ROWS 10
MENU TABMSGROW 26
MENU TIMEOUTROW 26
MENU TABMSG @T_AVVIO_SUGGERIMENTO@
MENU AUTOBOOT @T_AVVIO_AUTOMATICO@

MENU COLOR screen       37;40   #00000000 #00000000 none
MENU COLOR border       30;44   #00000000 #00000000 none
MENU COLOR title        1;36;44 #ffffffff #00000000 none
MENU COLOR unsel        37;44   #ffa1a1aa #00000000 none
MENU COLOR sel          7;37;40 #ff000000 #ffffffff none
MENU COLOR hotkey       1;37;44 #ffffffff #00000000 none
MENU COLOR hotsel       1;7;37;40 #ff000000 #ffffffff none
MENU COLOR disabled     1;30;44 #60cccccc #00000000 none
MENU COLOR tabmsg       31;40   #90ffffff #00000000 none
MENU COLOR timeout_msg  37;40   #b0ffffff #00000000 none
MENU COLOR timeout      1;37;40 #ffffffff #00000000 none

LABEL installa
	MENU LABEL @T_AVVIO_INSTALLA@
	MENU DEFAULT
	LINUX /live/%KERNEL%
	INITRD /live/%INITRD%
	APPEND @KERNEL_PARAMETRI_LIVE@ @OS_ID@.installa=1

LABEL installa-sicura
	MENU LABEL @T_AVVIO_INSTALLA_SICURA@
	LINUX /live/%KERNEL%
	INITRD /live/%INITRD%
	APPEND @KERNEL_PARAMETRI_LIVE@ @OS_ID@.installa=1 @OS_ID@.grafica=sicura

MENU SEPARATOR

LABEL disco
	MENU LABEL @T_AVVIO_DISCO@
	LOCALBOOT 0x80

LABEL spegni
	MENU LABEL @T_AVVIO_SPEGNI@
	COM32 poweroff.c32
