<?xml version="1.0" encoding="UTF-8"?>
<!-- Logo astratto: tre strati sovrapposti = snapshot, solidità, memoria.
     Nessuna lettera: resta valido qualunque sia OS_NAME. -->
<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">
  <title>@OS_NAME@</title>
  <defs>
    <linearGradient id="alto" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.95"/>
      <stop offset="1" stop-color="@COLORE_ACCENTO@"/>
    </linearGradient>
    <linearGradient id="medio" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="@COLORE_ACCENTO@"/>
      <stop offset="1" stop-color="@COLORE_ACCENTO_SCURO@"/>
    </linearGradient>
  </defs>
  <!-- strato inferiore -->
  <path d="M128 132 L216 176 L128 220 L40 176 Z" fill="@COLORE_ACCENTO_SCURO@" opacity="0.55"/>
  <!-- strato centrale -->
  <path d="M128 92 L216 136 L128 180 L40 136 Z" fill="url(#medio)" opacity="0.85"/>
  <!-- strato superiore -->
  <path d="M128 36 L216 80 L128 124 L40 80 Z" fill="url(#alto)"/>
  <path d="M128 36 L216 80 L128 124 L40 80 Z" fill="none" stroke="#FFFFFF" stroke-opacity="0.35" stroke-width="2"/>
</svg>
